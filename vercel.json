{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/healthz",
      "destination": "/api"
    },
    {
      "source": "/readyz",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api|healthz|readyz).*)",
      "destination": "/index.html"
    }
  ]
}
