# ==============================================================================
# Uptrail Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the values for your environment.
# NEVER commit real credentials or secret keys to version control.
# ==============================================================================

# Node Environment ('development' | 'production')
NODE_ENV=development
PORT=3000

# Application Base URL
APP_URL=http://localhost:3000

# Database Connection (MySQL / TiDB / PlanetScale)
# Example: mysql://user:password@localhost:3306/uptrail_db
DATABASE_URL=mysql://root:password@127.0.0.1:3306/uptrail

# Session & Authentication Secret (Generate a strong random 32+ char string)
# Example: openssl rand -hex 32
SESSION_SECRET=your-secure-random-session-secret-here

# Application Administrator / Owner Identification (Optional)
# If provided, the user with this email or numeric ID will automatically be granted admin permissions.
OWNER_EMAIL=admin@example.com
# OWNER_USER_ID=1

# ==============================================================================
# AI Provider Configuration (Zero-Cost / Provider-Independent)
# ==============================================================================
# Supported options: 'gemini' (Free Tier), 'groq' (Free Tier), 'ollama' (Local 100% Free), 'openai'
# For Google Gemini Free Tier: AI_PROVIDER=gemini, AI_API_KEY=<gemini-key>
# For Groq Developer Free Tier: AI_PROVIDER=groq, AI_API_KEY=<groq-key>
# For Local Ollama (100% Free & Offline): AI_PROVIDER=ollama (no key required!)
AI_PROVIDER=gemini
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gemini-1.5-flash


# ==============================================================================
# Object Storage (S3-Compatible)
# ==============================================================================
# Optional. When left blank, Uptrail automatically uses local disk storage (.storage/uploads).
# Compatible with AWS S3, Cloudflare R2, Backblaze B2, MinIO, Wasabi, etc.
# For Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
# For MinIO: http://localhost:9000
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ==============================================================================
# Notifications & Webhooks (Optional)
# ==============================================================================
# HTTPS webhook URL to receive notifications (e.g. Slack incoming webhook, Discord, custom handler)
NOTIFICATION_WEBHOOK_URL=

# ==============================================================================
# Client / Frontend Environment (Vite)
# ==============================================================================
# Only variables prefixed with VITE_ are exposed to the browser.
VITE_APP_TITLE=Uptrail
