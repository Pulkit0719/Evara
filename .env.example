# ==============================================================================
# Evara Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the values for your deployment.
# NEVER commit real credentials, production passwords, or secret keys to Git.
# ==============================================================================

# ==============================================================================
# 1. CORE REQUIRED VARIABLES (Production & Local)
# ==============================================================================

# Runtime environment ('production' for live deployments, 'development' for local)
NODE_ENV=production

# MySQL 8.0+, TiDB Cloud Serverless, PlanetScale, or compatible database instance
# In production, ensure TLS/SSL is active (e.g. ?ssl={"rejectUnauthorized":true})
# Format: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql://user:password@host:4000/evara?ssl={"rejectUnauthorized":true}

# Cryptographically secure random secret string used for session authentication cookies
# Must be at least 32 characters (64 hex characters recommended).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Do NOT use the development placeholder below in production!
SESSION_SECRET=paste-32-byte-random-hex-secret-here

# ==============================================================================
# 2. RUNTIME & SERVER (Local / Docker Only)
# ==============================================================================
# NOTE FOR VERCEL DEPLOYMENTS:
# Do NOT set PORT in Vercel environment variables. Vercel automatically manages
# edge routing and serverless function listeners.
# PORT is only used when running standalone (node dist/index.js) or in Docker.
PORT=3000

# ==============================================================================
# 3. OPTIONAL INTEGRATIONS
# ==============================================================================

# --- ADMIN BOOTSTRAP (Optional) ---
# Grant initial admin privileges to a specific email address or user ID
# OWNER_EMAIL=admin@example.com
# OWNER_USER_ID=1

# --- AI PROVIDER (Optional / Zero-Cost Compatible) ---
# Supported providers: 'gemini' (Free Tier), 'groq' (Free Tier), 'ollama' (Local Free), 'openai'
# If unconfigured, the application runs normally and returns safe fallback health guidance.
AI_PROVIDER=gemini
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# --- OBJECT STORAGE (Optional / S3-Compatible) ---
# NOTE: In serverless environments like Vercel, the local filesystem is ephemeral.
# For durable user file uploads across serverless instances, configure S3-compatible
# storage (Cloudflare R2, AWS S3, MinIO, Wasabi, Backblaze B2).
# If left blank, Evara falls back to local storage proxy for local development.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- EMAIL DISPATCH (Optional / SMTP) ---
# Standard SMTP configuration. If unconfigured, notification emails log to console.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@evara.app

# --- OUTBOUND NOTIFICATION WEBHOOKS (Optional) ---
# Outbound HTTPS webhook URL for administrative alerts and notification dispatch
NOTIFICATION_WEBHOOK_URL=
