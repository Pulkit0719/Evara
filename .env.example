# ==============================================================================
# Evara Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the values for your deployment.
# NEVER commit real credentials, production passwords, or secret keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
VITE_APP_ID=evara
VITE_APP_TITLE=Evara

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------
# MySQL 8.0+, TiDB, PlanetScale, or compatible database instance
# Format: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql://root:password@127.0.0.1:3306/evara

# ------------------------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------------------------
# 32+ character random secret string used for session authentication cookies
# Generate with: openssl rand -hex 32
SESSION_SECRET=evara-default-session-secret-key-change-me-in-production

# ------------------------------------------------------------------------------
# ADMIN (Optional)
# ------------------------------------------------------------------------------
# Grant initial admin privileges to a specific email address or user ID
OWNER_EMAIL=admin@example.com
# OWNER_USER_ID=1

# ------------------------------------------------------------------------------
# AI PROVIDER (Optional / Zero-Cost Compatible)
# ------------------------------------------------------------------------------
# Supported providers: 'gemini' (Free Tier), 'groq' (Free Tier), 'ollama' (Local Free), 'openai'
# For Google Gemini Free Tier: AI_PROVIDER=gemini, AI_API_KEY=<gemini-api-key>
# For Groq Developer Free Tier: AI_PROVIDER=groq, AI_API_KEY=<groq-api-key>
# For Local Ollama (100% Free & Offline): AI_PROVIDER=ollama (no API key required)
AI_PROVIDER=gemini
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# STORAGE (Optional / S3-Compatible)
# ------------------------------------------------------------------------------
# Optional. When left blank, Evara automatically uses local disk storage (.storage/uploads).
# Compatible with AWS S3, Cloudflare R2, MinIO, Backblaze B2, or Wasabi.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# EMAIL (Optional / SMTP)
# ------------------------------------------------------------------------------
# Standard SMTP configuration. If unconfigured, notification emails log to console.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@evara.app

# ------------------------------------------------------------------------------
# WEBHOOKS (Optional)
# ------------------------------------------------------------------------------
# Outbound HTTPS webhook URL for administrative alerts and notification dispatch
NOTIFICATION_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# DEPLOYMENT
# ------------------------------------------------------------------------------
# Public URL where the application is hosted
APP_URL=http://localhost:3000
